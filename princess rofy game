import streamlit as st
from PIL import Image
import arabic_reshaper
from bidi.algorithm import get_display

def display_arabic(text):
    reshaped_text = arabic_reshaper.reshape(text)
    return get_display(reshaped_text)

st.title("لعبة الأميرة روفان")

# استخدام session_state للحفاظ على تقدم اللعبة
if 'step' not in st.session_state:
    st.session_state.step = 0

# مرحلة الأسئلة الأولى
if st.session_state.step == 0:
    name = st.text_input("What Is Your Name ?")
    if name.lower() == "rovan":
        st.image("rofy-princess.jpeg")
        if st.button("التالي"):
            st.session_state.step += 1
            st.rerun()

elif st.session_state.step == 1:
    st.write(display_arabic("الان سنتناول الطعام"))
    ans = st.text_input(display_arabic("ما معني كلمة الطعام بالانجليزيه ؟"))
    if ans.lower() == "food":
        st.image("family food 1.jpeg")
        if st.button("التالي للمغامرة"):
            st.session_state.step += 1
            st.rerun()

